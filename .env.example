# ---------------------------------------------------------------------------
# Proxmox self-service portal
# Copy to .env and fill in. Mode 600 — this file holds cluster credentials.
# ---------------------------------------------------------------------------

# Where the SQLite database lives. In production this is on the data volume.
DATABASE_URL="file:/var/lib/proxmox-portal/portal.db"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Must match how users reach the portal, or callbacks break.
AUTH_URL="http://10.98.3.131:3000"
AUTH_TRUST_HOST="true"

# Separate key for encrypting guest root passwords at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Proxmox VE
# ---------------------------------------------------------------------------
PVE_ENDPOINT="https://10.99.0.1:8006/"
# user@realm!tokenid=uuid  — the same token Terraform uses.
PVE_API_TOKEN=""
# The default PVE certificate is self-signed.
PVE_INSECURE="true"

# The provider falls back to SSH for importing disk images and uploading
# snippets. This key must be in root's authorized_keys on every node.
PVE_SSH_USERNAME="root"
PVE_SSH_PRIVATE_KEY="/var/lib/proxmox-portal/ssh/terraform_pve"

# Cluster nodes talk over WireGuard, so the address the API reports for a node
# is not always reachable. Pin them: name=ip,name=ip
PVE_NODE_ADDRESSES="vmi3482497=10.99.0.1,server1=10.10.0.235"

# ---------------------------------------------------------------------------
# Terraform runner
# ---------------------------------------------------------------------------
TERRAFORM_BIN="/usr/local/bin/terraform"
PORTAL_DATA_DIR="/var/lib/proxmox-portal"
# Shared provider cache; without it every workspace re-downloads the provider.
TF_PLUGIN_CACHE_DIR="/var/lib/proxmox-portal/plugin-cache"
